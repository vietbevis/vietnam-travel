include ../mixins/profile-avatar.pug

header.header
  .inner-logo
    a(href=`/${pathAdmin}/start`)
      span KMA.
      span Admin
  .inner-wrap
    .inner-account
      +profileAvatar(account.avatar, account.fullName, 'inner-avatar')
      .inner-text
        .inner-name #{account.fullName}
        .inner-role #{account.roleName}
    button.inner-button-menu(type="button" aria-label="Mở menu quản trị" aria-expanded="false" aria-controls="admin-navigation")
      i.fa-solid.fa-bars(aria-hidden="true")
