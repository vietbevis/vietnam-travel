dialog(card-pin-modal aria-labelledby="card-pin-title" aria-describedby="card-pin-status")
  form.ca-modal-body(autocomplete="off" novalidate)
    .ca-modal-icon(aria-hidden="true")
      i.fa-solid.fa-lock
    h2#card-pin-title(card-pin-title) Nhập mã PIN
    p Nhập mã PIN gồm 6 chữ số của thẻ đang cắm.
    label.ca-pin-label(for="card-pin-input") Mã PIN (6 chữ số)
    input#card-pin-input.ca-pin-input(card-pin-input type="password" inputmode="numeric" maxlength="6" minlength="6" pattern="[0-9]{6}" autocomplete="off" placeholder="••••••" required)
    p#card-pin-status.ca-pin-status(card-pin-status role="status" aria-live="polite")
    .ca-modal-actions
      button.ca-btn.ca-btn-grey(card-pin-cancel type="button") Huỷ
      button.ca-btn(type="submit") Xác nhận
