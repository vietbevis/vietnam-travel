extends ../layouts/account.pug

block main
  .form-account
    h2.inner-title Nhập mã OTP
    p.inner-desc Vui lòng nhập mã OTP để tiếp tục
    
    form.inner-form#otp-password-form(method="post")
      .inner-group
        label(
          class="inner-label"
          for="otp"
        ) Mã OTP
        input(
          type="text"
          name="otp"
          id="otp"
          required
          inputmode="numeric"
          pattern="[0-9]{6}"
          maxlength="6"
          autocomplete="one-time-code"
          placeholder="Ví dụ: 123456"
          class="inner-control"
        )
      p.form-status(data-form-status role="status")
      button(class="inner-button" type="submit") Gửi mã OTP

    .inner-more
      a(data-resend-otp href=`/${pathAdmin}/account/forgot-password`) Yêu cầu gửi lại mã OTP
    
    .inner-more
      span Bạn đã nhớ mật khẩu?
      a(
        href=`/${pathAdmin}/account/login`
      ) Đăng nhập
