extends ../layouts/account.pug

block main
  .form-account
    h2.inner-title Quên mật khẩu
    p.inner-desc Vui lòng nhập email để tiếp tục
    
    form.inner-form#forgot-password-form(method="post")
      .inner-group
        label(
          class="inner-label"
          for="email"
        ) Email
        input(
          type="email"
          name="email"
          id="email"
          required
          maxlength="254"
          autocomplete="email"
          placeholder="Ví dụ: levana@gmail.com"
          class="inner-control"
        )
      p.form-status(data-form-status role="status")
      button(class="inner-button" type="submit") Gửi mã OTP
    
    .inner-more
      span Bạn đã nhớ mật khẩu?
      a(
        href=`/${pathAdmin}/account/login`
      ) Đăng nhập
