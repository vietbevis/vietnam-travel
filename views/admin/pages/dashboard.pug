extends ../layouts/default.pug
include ../mixins/admin-list.pug
include ../mixins/dashboard-statistics.pug

mixin amount(key, value)
  span(data-finance=key)= value.toLocaleString("vi-VN") + " đ"

block main
  if (permissions.includes("dashboard-view"))
    h1.box-title Tổng quan

    //- Section 1
    .section-1
      .inner-item
        .inner-icon
          img(src="/admin/assets/images/section-1-icon-1.svg")
        .inner-content
          .inner-title Quản trị viên
          .inner-number #{overview.totalAdmin.toLocaleString("vi-VN")}
      .inner-item
        .inner-icon
          img(src="/admin/assets/images/section-1-icon-1.svg")
        .inner-content
          .inner-title Khách hàng
          .inner-number #{overview.totalUser.toLocaleString("vi-VN")}
      .inner-item
        .inner-icon
          img(src="/admin/assets/images/section-1-icon-2.svg")
        .inner-content
          .inner-title Tổng đơn mọi thời kỳ
          .inner-number #{overview.totalOrder.toLocaleString("vi-VN")}
      .inner-item
        .inner-icon
          img(src="/admin/assets/images/section-1-icon-3.svg")
        .inner-content
          .inner-title Doanh thu ròng theo tháng
          .inner-number
            +amount('net', finance.period.net)
    //- End Section 1

    //- Thống kê thẻ thành viên (A11)
    if cardStats
      h2.ca-dash-title Thẻ thành viên
      .section-1
        .inner-item
          .inner-icon
            img(src="/admin/assets/images/section-1-icon-2.svg")
          .inner-content
            .inner-title Thẻ hoạt động
            .inner-number #{cardStats.byStatus.active.toLocaleString("vi-VN")}
            .inner-text Đã khoá: #{cardStats.byStatus.locked.toLocaleString("vi-VN")} · Đã thu hồi: #{cardStats.byStatus.revoked.toLocaleString("vi-VN")}
        .inner-item
          .inner-icon
            img(src="/admin/assets/images/section-1-icon-3.svg")
          .inner-content
            .inner-title Thanh toán tour bằng ví trong kỳ
            .inner-number
              +amount('card', finance.period.methods.card)
            .inner-text Số dư ví trên hệ thống: #{cardStats.serverBalance.toLocaleString("vi-VN")} đ
        .inner-item
          .inner-icon
            img(src="/admin/assets/images/section-1-icon-1.svg")
          .inner-content
            .inner-title Thẻ bị khoá / thu hồi
            .inner-number #{(cardStats.byStatus.locked + cardStats.byStatus.revoked).toLocaleString("vi-VN")}
      .section-3
        h2.ca-dash-title Tỉ lệ check-in (khởi hành trong ±7 ngày)
        .table-1
          table
            thead
              tr
                th Tour
                th Ngày khởi hành
                th Tổng vé
                th Vé trên thẻ (đã ghi hoặc đã dùng)
                th Đã check-in
            tbody
              each row in cardStats.checkinRate
                tr
                  td #{row.tourName}
                  td #{new Date(row.departureDate).toLocaleDateString("vi-VN", {timeZone: "Asia/Ho_Chi_Minh"})}
                  td #{row.total}
                  td #{row.written}
                  td #{row.used}
              else
                tr
                  td(colspan="5") Không có tour khởi hành trong khoảng này.
    //- End thống kê thẻ

    //- Section 2
    .section-2(data-dashboard-finance=JSON.stringify(finance))
      .inner-head
        h2.inner-title Biểu đồ doanh thu
        form.inner-filter(method="get")
          input(
            type="month"
            name="month"
            value=selectedMonth
            min="1900-01"
            max="9999-12"
            required
            aria-label="Tháng của biểu đồ doanh thu"
          )
          noscript
            button.ca-btn(type="submit") Xem
      .inner-chart
        canvas(id="revenue-chart")
      p(data-revenue-status role="status" hidden)
      +dashboardStatistics(finance, paymentMethods)
    //- End Section 2

    if permissions.includes("order-view")
      .section-3
        h2.inner-title Đơn hàng gần đây
        a.ca-btn.dashboard-orders-link(href=`/${pathAdmin}/order/list`) Mở danh sách đơn hàng
        .table-1
          table
            thead
              tr
                th Mã đơn
                th Khách đặt
                th Tổng đơn
                th Phương thức
                th Thanh toán
                th Trạng thái đơn
                th Ngày đặt
            tbody
              each order in orders
                tr
                  td
                    a(href=`/${pathAdmin}/order/edit/${order.id}`)= order.code || 'Chi tiết'
                  td= order.customer
                  td
                    +listMoney(order.amount)
                  td= order.method
                  td= order.payment
                  td= order.status
                  td= order.date || 'Chưa xác định'
              else
                tr
                  td(colspan="7") Chưa có đơn hàng để hiển thị.
