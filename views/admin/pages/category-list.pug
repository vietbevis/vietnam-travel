extends ../layouts/default.pug
include ../mixins/list-pagination.pug
include ../mixins/admin-list.pug

block main
  - const canEdit = permissions.includes("category-edit");
  - const canDelete = permissions.includes("category-delete");
  h1.box-title Quản lý danh mục

  - const listUrl = `/${pathAdmin}/category/list`
  form(method="get" action=listUrl data-admin-list data-category-list data-resource="category")
    .section-4
      .inner-wrap
        .inner-item.inner-label
          i.fa-solid.fa-filter(aria-hidden="true")
          |  Bộ lọc
        +listFilter("status", "Trạng thái", [{value:"active",label:"Hoạt động"},{value:"inactive",label:"Tạm dừng"}], filters.status, {"filter-status": true})
        +listActor("createdBy", "Người tạo", accountAdminList, filters.createdBy, {"filter-created-by": true})
        +listDates("tạo", filters, true)
        +listReset(listUrl)
    .section-5
      .inner-wrap
        if canEdit || canDelete
          - const options = []
          - if (canEdit) options.push({value:"active",label:"Hoạt động"},{value:"inactive",label:"Dừng hoạt động"})
          - if (canDelete) options.push({value:"delete",label:"Xóa"})
          +listBulk(`/${pathAdmin}/category/change-multi`, options, categoryList.length, {"category-change-multi": true})
        +listSearch("keyword", "Tìm kiếm danh mục", filters.keyword, pagination.limit, true)
        if permissions.includes("category-create")
          .inner-button-create
            a(href=`/${pathAdmin}/category/create`) + Tạo mới
        if permissions.includes("category-trash")
          .inner-button-trash
            a(href=`/${pathAdmin}/category/trash` data-list-return) Thùng rác

  //- Section 6
  .section-6
    .table-2
      table
        thead
          tr
            th(class="inner-center")
              if canEdit || canDelete
                +listCheckAll("Chọn tất cả danh mục đang hiển thị", categoryList.length)
            th Tên danh mục
            th Ảnh đại diện
            th(class="inner-center") Vị trí
            th(class="inner-center") Trạng thái
            th Tạo bởi
            th Cập nhật bởi
            th Hành động
        tbody
          if categoryList.length === 0
            tr
              td.inner-center(colspan="8" role="status") #{listError || "Không tìm thấy danh mục phù hợp"}
          each item in categoryList
            tr
              td(class="inner-center")
                if canEdit || canDelete
                  +listCheck(item.id, item.name)
              td #{item.name}
              td
                if item.avatar
                  img(src=item.avatar class="inner-avatar" alt="")
              td(class="inner-center") #{item.position}
              td(class="inner-center")
                if (item.status == "active")
                  .badge.badge-green Hoạt động
                else if (item.status == "inactive")
                  .badge.badge-red Tạm dừng
              td
                div #{item.createdByFullName}
                div.inner-time #{item.createdAtFormat}
              td
                div #{item.updatedByFullName}
                div.inner-time #{item.updatedAtFormat}
              td
                .inner-buttons
                  if canEdit
                    a(
                      href=`/${pathAdmin}/category/edit/${item.id}`
                      class="inner-edit"
                      aria-label=`Sửa ${item.name}`
                    ) <i class="fa-regular fa-pen-to-square"></i>
                  if canDelete
                    +listAction(`/${pathAdmin}/category/delete/${item.id}`, "delete", `Xóa ${item.name}`, "fa-regular fa-trash-can", "inner-delete", {"category-delete": true})
  //- End Section 6

  +listPagination(pagination, categoryList.length, "Trang danh mục")
