extends ../layouts/default.pug
include ../mixins/list-pagination.pug
include ../mixins/admin-list.pug
include ../mixins/tour-list-table.pug

block main
  - const listUrl = `/${pathAdmin}/tour/list`
  - const canEdit = permissions.includes("tour-edit")
  - const canDelete = permissions.includes("tour-delete")
  - const canSelect = canEdit || canDelete
  h1.box-title Quản lý tour
  form(method="get" action=listUrl data-admin-list data-resource="tour")
    .section-4
      .inner-wrap
        .inner-item.inner-label
          i.fa-solid.fa-filter(aria-hidden="true")
          |  Bộ lọc
        +listFilter("status", "Trạng thái", [{value:"active",label:"Hoạt động"},{value:"inactive",label:"Tạm dừng"}], filters.status)
        +listActor("createdBy", "Người tạo", accountAdminList, filters.createdBy)
        +listDates("tạo", filters)
        +listFilter("category", "Danh mục", categoryList.map(item => ({value:item.id,label:item.name})), filters.category)
        +listFilter("price", "Giá người lớn", [{value:"under-2m",label:"Dưới 2 triệu"},{value:"2m-4m",label:"Từ 2 đến dưới 4 triệu"},{value:"4m-8m",label:"Từ 4 đến dưới 8 triệu"},{value:"from-8m",label:"Từ 8 triệu"}], filters.price)
        +listReset(listUrl)
    .section-5
      .inner-wrap
        if canSelect
          - const options = []
          - if (canEdit) options.push({value:"active",label:"Hoạt động"},{value:"inactive",label:"Dừng hoạt động"})
          - if (canDelete) options.push({value:"delete",label:"Xóa"})
          +listBulk(`/${pathAdmin}/tour/change-multi`, options, tourList.length)
        +listSearch("keyword", "Tìm kiếm tour", filters.keyword, pagination.limit)
        if permissions.includes("tour-create")
          .inner-button-create
            a(href=`/${pathAdmin}/tour/create`) + Tạo mới
        if permissions.includes("tour-trash")
          .inner-button-trash
            a(href=`/${pathAdmin}/tour/trash` data-list-return) Thùng rác
  +tourListTable(tourList, false, canSelect, canEdit, canDelete, listError)
  +listPagination(pagination, tourList.length, "Trang tour")
