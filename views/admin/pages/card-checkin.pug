extends ../layouts/default.pug

block main
  .ca-page
    h1.box-title Check-in tour
    p.ca-subtitle Chỉ hiển thị tour có ngày khởi hành trong cửa sổ check-in: từ 00:00 một ngày trước đến hết ngày khởi hành (giờ Việt Nam).
    if !tours.length
      .ca-card
        p.ca-note(data-checkin-empty)
          i.fa-regular.fa-calendar-xmark
          |  Hiện không có tour nào trong cửa sổ check-in.
    else
      form.ca-filter(method="get")
        .ca-filter-title
          i.fa-solid.fa-route
          | Tour
        .ca-field(style="flex:3 1 320px")
          label(for="tourId") Tour
          select#tourId(name="tourId")
            option(value="") Chọn tour
            each tour in tours
              option(value=tour.tourId selected=tour.tourId===selected)= tour.name
        .ca-field
          label(for="booking-search") Khách đã đặt
          input#booking-search(name="keyword" type="search" value=keyword placeholder="Tên, số điện thoại, mã đơn" maxlength="120")
        .ca-actions
          button.ca-btn(type="submit")
            i.fa-solid.fa-users
            | Xem khách đã đặt
          if selected && keyword
            a.ca-reset(href=`?tourId=${selected}`) Xóa tìm kiếm
    if selected
      dl.ca-checkin-metrics(aria-label="Tổng hợp vé của tour")
        each metric in [['Số mục vé', summary.tickets], ['Tổng số khách', summary.passengers], ['Mục đã check-in', summary.checkedIn], ['Mục chưa check-in', summary.tickets - summary.checkedIn]]
          div
            dt= metric[0]
            dd= metric[1]
      .ca-checkin-layout
        div
          .ca-table-wrap(tabindex="0" aria-label="Danh sách khách đã đặt")
            table.ca-table
              thead
                tr
                  th Mã đơn
                  th Khởi hành
                  th Khách hàng
                  th SĐT
                  th.ca-num Số khách
                  th Trạng thái vé
                  th Giờ check-in
              tbody
                each booking in bookings
                  tr(data-checkin-row)
                    td
                      span.ca-code= booking.orderCode
                    td= new Date(booking.departureDate).toLocaleDateString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh', day:'2-digit', month:'2-digit', year:'numeric'})
                    td= booking.fullName || 'Chưa cập nhật'
                    td= booking.phone || 'Chưa cập nhật'
                    td.ca-num= booking.pax
                    td
                      span.badge(class=booking.ticketStatus==='used' ? 'badge-green' : booking.checkinPending ? 'badge-orange' : booking.ticketStatus==='written' ? 'badge-blue' : 'badge-grey')= booking.checkinPending ? 'Chờ đối soát check-in' : ticketStatusLabel(booking.ticketStatus)
                    td= booking.checkedInAt ? new Date(booking.checkedInAt).toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh', day:'2-digit', month:'2-digit', year:'numeric', hour:'2-digit', minute:'2-digit'}) : '—'
                if !bookings.length
                  tr.ca-empty
                    td(colspan="7")
                      i.fa-regular.fa-user
                      = keyword ? 'Không có khách khớp nội dung tìm kiếm.' : 'Chưa có khách đã thanh toán cho tour này.'
        section.ca-card(data-card-checkin data-tour-id=selected data-card-base=`/${pathAdmin}/card` aria-label="Quét thẻ check-in")
          .ca-scanner
            .ca-scanner-icon(aria-hidden="true")
              i.fa-solid.fa-id-card-clip
            button.ca-btn.ca-btn-lg(type="button" data-checkin-scan)
              i.fa-solid.fa-wifi
              | Quét thẻ
            p.ca-status(data-checkin-message role="status" aria-live="polite")
          div.ca-result(data-checkin-result hidden)
            img.ca-photo(data-checkin-photo width="240" height="300" alt="Ảnh chân dung trên thẻ")
            .ca-result-body
              dl.ca-dl
                dt Họ tên
                dd(data-checkin-name)
                dt Nhóm máu
                dd(data-checkin-blood)
                dt Dị ứng
                dd(data-checkin-allergies)
              fieldset.ca-checkin-select
                legend Vé của khách cho tour đang chọn
                label(data-checkin-select-all hidden)
                  input(type="checkbox")
                  |  Chọn tất cả vé hợp lệ
                ul(data-checkin-items)
                p.ca-note(data-checkin-selection role="status")
              button.ca-btn.ca-btn-green(type="button" data-checkin-confirm hidden)
                i.fa-solid.fa-circle-check
                span(data-checkin-confirm-label) Xác nhận check-in
  script(src="/admin/assets/js/card-admin.js" defer)
