extends ../layouts/default.pug

block main
  h1.box-title Quản lý đơn hàng

  form#order-filter-form(
    method="GET"
    action=`/${pathAdmin}/order/list`
  )
    //- Section 4
    .section-4
      .inner-wrap
        .inner-item.inner-label
          i.fa-solid.fa-filter
          | Bộ lọc

        .inner-item
          select(name="status")
            option(value="") Tất cả trạng thái
            each item in orderStatuses
              option(
                value=item.value
                selected=(filters.status === item.value)
              )= item.label

        .inner-item.inner-date
          input(
            type="date"
            name="startDate"
            value=filters.startDate
          )
          span -
          input(
            type="date"
            name="endDate"
            value=filters.endDate
          )

        .inner-item
          select(name="paymentMethod")
            option(value="") Tất cả phương thức
            each item in paymentMethods
              option(
                value=item.value
                selected=(filters.paymentMethod === item.value)
              )= item.label

        .inner-item
          select(name="paymentStatus")
            option(value="") Tất cả thanh toán
            each item in paymentStatuses
              option(
                value=item.value
                selected=(filters.paymentStatus === item.value)
              )= item.label

        .inner-item
          button.inner-button-apply(type="submit")
            i.fa-solid.fa-check
            |  Áp dụng

        .inner-item.inner-reset
          a(href=`/${pathAdmin}/order/list`)
            i.fa-solid.fa-rotate-left
            | Xóa bộ lọc

    //- Section 5
    .section-5
      .inner-wrap
        .inner-search
          i.fa-solid.fa-magnifying-glass
          input(
            type="search"
            name="q"
            value=filters.q
            placeholder="Mã đơn, tên khách, SĐT"
            maxlength="80"
          )
        .inner-button-create
          button(type="submit") Tìm kiếm

  //- Section 6
  .section-6
    .table-2
      table
        thead
          tr
            th Mã
            th Thông tin khách
            th Danh sách tour
            th Thanh toán
            th Trạng thái
            th(class="inner-center") Ngày đặt
            th Hành động
        tbody
          if orderList.length === 0
            tr
              td(colspan="7") Không tìm thấy đơn hàng phù hợp.

          each orderDetail in orderList                
            tr
              td
                .inner-code #{orderDetail.orderCode}
              td
                div Họ tên: #{orderDetail.fullName}
                div SĐT: #{orderDetail.phone}
                div Ghi chú: #{orderDetail.note}
              td
                each item in orderDetail.items
                  .inner-item
                    .inner-image
                      img(src=item.avatar, alt=item.name)
                    .inner-content
                      .inner-name #{item.name}
                      .inner-quantity Người lớn: #{item.quantityAdult} x #{item.priceNewAdult.toLocaleString("vi-VN")} đ
                      .inner-quantity Trẻ em: #{item.quantityChildren} x #{item.priceNewChildren.toLocaleString("vi-VN")} đ
                      .inner-quantity Em bé: #{item.quantityBaby} x #{item.priceNewBaby.toLocaleString("vi-VN")} đ
              td
                div Tạm tính: #{orderDetail.subTotal.toLocaleString("vi-VN")} đ
                div Giảm: #{orderDetail.discount.toLocaleString("vi-VN")} đ
                //- div Mã giảm: TOURMUAHE2024
                div Thanh toán: #{orderDetail.total.toLocaleString("vi-VN")} đ
                div PTTT: #{orderDetail.paymentMethodName}
                div TTTT: #{orderDetail.paymentStatusName}
              td
                if (orderDetail.status == "initial")
                  .badge.badge-orange #{orderDetail.statusName}
                else if (orderDetail.status == "done")
                  .badge.badge-green #{orderDetail.statusName}
                else if (orderDetail.status == "cancel")
                  .badge.badge-red #{orderDetail.statusName}
              td(class="inner-center")
                div #{orderDetail.createdAtTime}
                div #{orderDetail.createdAtDate}
              td
                .inner-buttons
                  a(
                    href=`/${pathAdmin}/order/edit/${orderDetail.id}`
                    class="inner-edit"
                  ) <i class="fa-regular fa-pen-to-square"></i>
                  if permissions.includes("order-delete") && orderDetail.status === "cancel" && orderDetail.paymentStatus === "unpaid" && !orderDetail.customerId && !orderDetail.cardTxRef
                    button.inner-delete(
                      type="button"
                      data-order-soft-delete=orderDetail.id
                      title="Ẩn đơn đã hủy"
                    )
                      i.fa-regular.fa-trash-can
  //- End Section 6

  //- Section 7
  .section-7
    span.inner-label
      | Hiển thị #{startRecord} - #{endRecord} của #{totalOrders}

    if totalPages > 1
      select.inner-pagination(
        data-order-page
        aria-label="Chọn trang"
      )
        each number in pages
          option(
            value=number
            selected=(page === number)
          ) Trang #{number}

  //- End Section 7