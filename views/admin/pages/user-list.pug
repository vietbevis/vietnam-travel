extends ../layouts/default.pug
include ../mixins/profile-avatar.pug

block main
  h1.box-title Quản lý khách hàng
  form.ca-filter(method="GET" action=`/${pathAdmin}/user/list`)
    .ca-filter-title
      i.fa-solid.fa-magnifying-glass
      | Tìm kiếm
    .ca-field(style="flex:3 1 320px")
      label(for="customer-search") Tìm theo tên, email hoặc số điện thoại
      input#customer-search(type="search" name="keyword" value=keyword maxlength="120" placeholder="Tên, email hoặc số điện thoại")
    .ca-actions
      button.ca-btn(type="submit") Tìm kiếm
      a.ca-reset(href=`/${pathAdmin}/user/list`)
        i.fa-solid.fa-rotate-left
        | Xóa bộ lọc
  .section-6
    .table-2
      table
        thead
          tr
            th Họ tên
            th Ảnh đại diện
            th Email
            th Số điện thoại
            th Trạng thái thẻ hiện hành
        tbody
          each customer in customers
            tr
              td= customer.fullName || 'Chưa cung cấp'
              td
                +profileAvatar(customer.avatar, customer.fullName, 'inner-avatar')
              td= customer.email
              td= customer.phone || 'Chưa cung cấp'
              td
                if customer.card
                  span.badge(class=({issuing:'badge-blue',active:'badge-green',locked:'badge-orange'})[customer.card.status]||'badge-grey')= ({issuing:'Đang phát hành',active:'Hoạt động',locked:'Đã khóa'}[customer.card.status] || customer.card.status)
                else
                  span.badge.badge-grey Chưa có thẻ hiện hành
          else
            tr
              td(colspan="5") Không có khách hàng phù hợp.
  p.ca-note Hiển thị tối đa 200 khách hàng. Dùng tìm kiếm để thu hẹp kết quả.
