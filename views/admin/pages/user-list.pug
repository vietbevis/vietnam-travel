extends ../layouts/default.pug

block main
  h1.box-title Quản lý khách hàng
  form(method="GET" action=`/${pathAdmin}/user/list`)
    label(for="customer-search") Tìm theo tên, email hoặc số điện thoại
    input#customer-search(type="search" name="keyword" value=keyword maxlength="120")
    button(type="submit") Tìm kiếm
    a(href=`/${pathAdmin}/user/list`) Xóa bộ lọc
  .section-6
    .table-2
      table
        thead
          tr
            th Họ tên
            th Ảnh đại diện
            th Email
            th Số điện thoại
            th Trạng thái thẻ hiện hành
        tbody
          each customer in customers
            tr
              td= customer.fullName || 'Chưa cung cấp'
              td
                if customer.avatar
                  img(src=customer.avatar alt="Ảnh khách hàng" class="inner-avatar")
              td= customer.email
              td= customer.phone || 'Chưa cung cấp'
              td= customer.card ? ({issuing:'Đang phát hành',active:'Hoạt động',locked:'Đã khóa'}[customer.card.status] || customer.card.status) : 'Chưa có thẻ hiện hành'
          else
            tr
              td(colspan="5") Không có khách hàng phù hợp.
  p Hiển thị tối đa 200 khách hàng. Dùng tìm kiếm để thu hẹp kết quả.
