extends ../layouts/default.pug
include ../mixins/tinymce.pug
include ../mixins/options.pug

block main
  h1.box-title Chỉnh sửa danh mục

  .section-8
    form#category-edit-form(method="post" novalidate data-api=`/${pathAdmin}/category/edit/${categoryDetail.id}`)
      .inner-group
        label(class="inner-label" for="name") Tên danh mục
        input(type="text" id="name" name="name" value=categoryDetail.name)
      .inner-group
        label(class="inner-label" for="parent") Danh mục cha
        select(id="parent" name="parent")
          option(value="") -- Chọn danh mục --
          +options(categoryList, 0, selectedParent)
      .inner-group
        label(class="inner-label" for="position") Vị trí
        input(type="text" id="position" name="position" inputmode="numeric" value=categoryDetail.position)
      .inner-group
        label(class="inner-label" for="status") Trạng thái
        select(id="status" name="status")
          option(
            value="active"
            selected=(categoryDetail.status == "active" ? true : false)
          ) Hoạt động
          option(
            value="inactive"
            selected=(categoryDetail.status == "inactive" ? true : false)
          ) Tạm dừng
      .inner-group.inner-two-col
        label(class="inner-label" for="avatar") Ảnh đại diện
        div(class="inner-upload-image" image-default=categoryDetail.avatar)
          input(type="file" id="avatar" accept="image/jpeg,image/png,image/gif,image/webp" filepond-image name="avatar" data-clear-image)
      .inner-group.inner-two-col
        label(class="inner-label" for="description") Mô tả
        textarea(id="description" textarea-mce name="description") #{categoryDetail.description}
      .inner-button.inner-two-col
        button(type="submit") Cập nhật
    .inner-back
      a(href=`/${pathAdmin}/category/list`) Quay lại danh sách

block editor
  +tinyMce
