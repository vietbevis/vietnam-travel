extends ../layouts/default.pug
include ../mixins/list-pagination.pug

block main
  if (permissions.includes("tour-trash"))
    h1.box-title Thùng rác tour

    //- Section 5
    .section-5
      .inner-wrap
        .inner-change-status(
          change-multi
          data-api=`/${pathAdmin}/tour/trash/change-multi`
        )
          .inner-item
            select
              option(value="") -- Hành động --
              option(value="undo") Khôi phục
              option(value="delete-destroy") Xóa vĩnh viễn
          .inner-item
            button Áp dụng
    //- End Section 5

    //- Section 6
    .section-6
      .table-2
        table
          thead
            tr
              th(class="inner-center")
                input(type="checkbox" class="inner-check" aria-label="Chọn tất cả tour trong thùng rác" check-all)
              th Tên tour
              th Ảnh đại diện
              th Giá
              th Còn lại
              th(class="inner-center") Vị trí
              th(class="inner-center") Trạng thái
              th Tạo bởi
              th Xóa bởi
              th Hành động
          tbody
            each item in tourList
              tr
                td(class="inner-center")
                  input(type="checkbox" class="inner-check" aria-label=`Chọn ${item.name}` check-item=item.id)
                td #{item.name}
                td
                  img(src=item.avatar class="inner-avatar")
                td
                  div NL: #{item.priceNewAdult.toLocaleString("vi-VN")} đ
                  div TE: #{item.priceNewChildren.toLocaleString("vi-VN")} đ
                  div EB: #{item.priceNewBaby.toLocaleString("vi-VN")} đ
                td
                  div NL: #{item.stockAdult}
                  div TE: #{item.stockChildren}
                  div EB: #{item.stockBaby}
                td(class="inner-center") #{item.position}
                td(class="inner-center")
                  if (item.status == "active")
                    .badge.badge-green Hoạt động
                  else if (item.status == "inactive")
                    .badge.badge-red Tạm dừng
                td
                  div #{item.createdByFullName}
                  div.inner-time #{item.createdAtFormat}
                td
                  div #{item.deletedByFullName}
                  div.inner-time #{item.deletedAtFormat}
                td
                  .inner-buttons
                    button(
                      class="inner-undo"
                      button-delete
                      aria-label=`Khôi phục ${item.name}`
                      data-api=`/${pathAdmin}/tour/undo/${item.id}`
                    ) <i class="fa-solid fa-rotate-left"></i>
                    button(
                      class="inner-delete"
                      button-delete
                      data-confirm="destroy"
                      aria-label=`Xóa vĩnh viễn ${item.name}`
                      data-api=`/${pathAdmin}/tour/delete-destroy/${item.id}`
                    ) <i class="fa-regular fa-trash-can"></i>
    //- End Section 6

            else
              tr
                td(colspan="10") Thùng rác tour đang trống.

    +listPagination(pagination, tourList.length, 'Trang thùng rác tour')
