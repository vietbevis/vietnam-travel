extends ../layouts/default.pug
include ../mixins/list-pagination.pug
include ../mixins/admin-list.pug
include ../mixins/tour-list-table.pug

block main
  - const trashUrl = `/${pathAdmin}/tour/trash`
  h1.box-title Thùng rác tour
  form(method="get" action=trashUrl data-admin-list data-resource="tour")
    .section-4
      .inner-wrap
        .inner-item.inner-label
          i.fa-solid.fa-filter(aria-hidden="true")
          |  Bộ lọc
        +listActor("deletedBy", "Người xóa", accountAdminList, filters.deletedBy)
        +listDates("xóa", filters)
        +listReset(trashUrl)
    .section-5
      .inner-wrap
        +listBulk(trashUrl + "/change-multi", [{value:"undo",label:"Khôi phục"},{value:"delete-destroy",label:"Xóa vĩnh viễn"}], tourList.length, {"change-multi-g2": true})
        +listSearch("keyword", "Tìm kiếm tour", filters.keyword, pagination.limit)
        if permissions.includes("tour-view")
          .inner-button-create
            a(href=`/${pathAdmin}/tour/list` data-list-return) Về danh sách
  +tourListTable(tourList, true, true, false, false, listError)
  +listPagination(pagination, tourList.length, "Trang thùng rác tour")
