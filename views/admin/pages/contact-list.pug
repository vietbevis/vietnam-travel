extends ../layouts/default.pug

include ../mixins/list-pagination.pug

block main
  h1.box-title Thông tin liên hệ
  .section-6
    .table-2(tabindex="0" aria-label="Danh sách đăng ký nhận tin")
      table
        thead
          tr
            th Email
            th Ngày đăng ký
        tbody
          each item in contactList
            tr
              td= item.email
              td= item.createdAtFormat
          else
            tr
              td(colspan="2") Chưa có lượt đăng ký nhận tin.
  +listPagination(pagination, contactList.length, 'Trang liên hệ')
