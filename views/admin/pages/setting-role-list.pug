extends ../layouts/default.pug

include ../mixins/list-pagination.pug

block main
  h1.box-title Nhóm quyền
  if permissions.includes("role-create")
    .section-5
      .inner-wrap
        .inner-button-create
          a(href=`/${pathAdmin}/setting/role/create`) + Tạo mới
  .section-6
    .table-2(tabindex="0" aria-label="Danh sách nhóm quyền")
      table
        thead
          tr
            th Tên nhóm quyền
            th Mô tả ngắn
            th Hành động
        tbody
          each item in roleList
            tr
              td= item.name
              td= item.description || 'Chưa có mô tả'
              td
                if permissions.includes("role-edit")
                  .inner-buttons
                    a.inner-edit(href=`/${pathAdmin}/setting/role/edit/${item.id}` aria-label="Sửa nhóm quyền")
                      i.fa-regular.fa-pen-to-square(aria-hidden="true")
                else
                  span Không có quyền sửa
          else
            tr
              td(colspan="3") Chưa có nhóm quyền.
  +listPagination(pagination, roleList.length, 'Trang nhóm quyền')
