extends ../layouts/default.pug
include ../mixins/profile-avatar.pug
include ../mixins/list-pagination.pug

block main
  h1.box-title Tài khoản quản trị

  if permissions.includes("account-admin-create")
    .section-5
      .inner-wrap
        .inner-button-create
          a(href=`/${pathAdmin}/setting/account-admin/create`) + Tạo mới

  //- Section 6
  .section-6
    .table-2
      table
        thead
          tr
            th Họ tên
            th(class="inner-center") Ảnh đại diện
            th Email
            th Số điện thoại
            th Nhóm quyền
            th Chức vụ
            th Trạng thái
            th Hành động
        tbody
          each item in accountAdminList
            tr
              td #{item.fullName}
              td(class="inner-center")
                +profileAvatar(item.avatar, item.fullName, 'inner-avatar')
              td #{item.email}
              td #{item.phone}
              td #{item.roleName}
              td #{item.positionCompany}
              td
                if (item.status == "active")
                  .badge.badge-green Hoạt động
                else if(item.status == "inactive")
                  .badge.badge-red Tạm dừng
                else if(item.status == "initial")
                  .badge.badge-orange Khởi tạo
              td
                if permissions.includes("account-admin-edit")
                  .inner-buttons
                    a.inner-edit(href=`/${pathAdmin}/setting/account-admin/edit/${item.id}` aria-label="Sửa tài khoản")
                      i.fa-regular.fa-pen-to-square(aria-hidden="true")
                else
                  span Không có quyền sửa
          else
            tr
              td(colspan="8") Chưa có tài khoản quản trị.

  +listPagination(pagination, accountAdminList.length, 'Trang tài khoản')
