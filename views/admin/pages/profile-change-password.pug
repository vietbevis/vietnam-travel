extends ../layouts/default.pug

block main
  h1.box-title Đổi mật khẩu

  .section-8
    form#profile-change-password-form(method="post")
      .inner-group
        label(class="inner-label" for="currentPassword") Mật khẩu hiện tại
        input(type="password" id="currentPassword" name="currentPassword" autocomplete="current-password" required)
      .inner-group
        label(class="inner-label" for="password") Mật khẩu mới
        input(type="password" id="password" name="password" autocomplete="new-password" required minlength="8" maxlength="72")
      .inner-group
        label(class="inner-label" for="confirmPassword") Nhập lại mật khẩu mới
        input(type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" required minlength="8" maxlength="72")
      p.form-status.inner-two-col(data-form-status role="status")
      .inner-button.inner-two-col
        button(type="submit") Đổi mật khẩu
