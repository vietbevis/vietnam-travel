extends ../layouts/default.pug
include ../mixins/card-audit.pug
include ../mixins/list-pagination.pug

block main
  .ca-page
    h1.box-title Nhật ký thẻ
    p.ca-subtitle Nhật ký chỉ xem, theo thời gian Việt Nam; mới nhất trước.

    form.ca-filter(method="get")
      .ca-filter-title
        i.fa-solid.fa-filter
        | Bộ lọc
      .ca-field
        label(for="cardId") Mã thẻ
        input#cardId(name="cardId" value=filters.cardId maxlength="32" placeholder="Mã thẻ")
      .ca-field
        label(for="action") Thao tác
        input#action(name="action" value=filters.action maxlength="80" list="card-audit-actions" placeholder="Chọn hoặc nhập mã thao tác")
        datalist#card-audit-actions
          each label, action in auditActions
            option(value=action label=label)
      .ca-field
        label(for="actorId") Mã người thực hiện
        input#actorId(name="actorId" value=filters.actorId maxlength="24")
      .ca-field
        label(for="result") Kết quả
        select#result(name="result")
          option(value="") Tất cả
          option(value="success" selected=filters.result==='success') Thành công
          option(value="fail" selected=filters.result==='fail') Thất bại
      .ca-field
        label(for="from") Từ ngày
        input#from(type="date" name="from" value=filters.from)
      .ca-field
        label(for="to") Đến hết ngày
        input#to(type="date" name="to" value=filters.to)
      .ca-actions
        button.ca-btn(type="submit")
          i.fa-solid.fa-magnifying-glass
          | Lọc nhật ký
        a.ca-reset(href=`/${pathAdmin}/card/log`)
          i.fa-solid.fa-rotate-left
          | Xóa bộ lọc

    +cardAudit(logs, true)
    +listPagination(pagination, logs.length, 'Trang nhật ký')
