extends ../layouts/default.pug

block main
  .ca-page
    h1.box-title Nhật ký thẻ
    p.ca-subtitle Nhật ký chỉ xem, theo thời gian Việt Nam; mới nhất trước.

    form.ca-filter(method="get")
      .ca-filter-title
        i.fa-solid.fa-filter
        | Bộ lọc
      .ca-field
        label(for="cardId") Mã thẻ
        input#cardId(name="cardId" value=filters.cardId maxlength="32" placeholder="Mã thẻ")
      .ca-field
        label(for="action") Thao tác
        input#action(name="action" value=filters.action maxlength="80" placeholder="Ví dụ: card.lock")
      .ca-field
        label(for="from") Từ ngày
        input#from(type="date" name="from" value=filters.from)
      .ca-field
        label(for="to") Đến hết ngày
        input#to(type="date" name="to" value=filters.to)
      .ca-actions
        button.ca-btn(type="submit")
          i.fa-solid.fa-magnifying-glass
          | Lọc nhật ký
        a.ca-reset(href=`/${pathAdmin}/card/log`)
          i.fa-solid.fa-rotate-left
          | Xóa bộ lọc

    p.ca-meta
      span Tổng <strong>#{pagination.total}</strong> mục
      span Trang #{pagination.page}/#{pagination.pages}

    .ca-table-wrap
      table.ca-table
        thead
          tr
            th Thời gian
            th Mã thẻ
            th Thao tác
            th Người thực hiện
            th Kết quả
            th Chi tiết
            th IP
        tbody
          each entry in logs
            tr(data-card-log-row)
              td= new Date(entry.createdAt).toLocaleString('vi-VN', {timeZone:'Asia/Ho_Chi_Minh'})
              td= entry.cardId || ''
              td= entry.action
              td #{entry.actorType} #{entry.actorId || ''}
              td
                - const ok = /^(success|ok)$/i.test(String(entry.result))
                span.badge(class=ok ? 'badge-green' : 'badge-grey')= entry.result
              td.ca-detail-json= entry.detail ? JSON.stringify(entry.detail) : ''
              td= entry.ip || ''
          if !logs.length
            tr.ca-empty
              td(colspan="7")
                i.fa-regular.fa-clipboard
                | Không có nhật ký phù hợp.

    nav.ca-pagination(aria-label="Phân trang nhật ký")
      if pagination.previous
        a(href=pagination.previous)
          i.fa-solid.fa-chevron-left
          | Trang trước
      if pagination.next
        a(href=pagination.next)
          | Trang sau
          i.fa-solid.fa-chevron-right
