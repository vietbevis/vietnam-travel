doctype html
html
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{pageTitle}
    link(rel="stylesheet", href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.6.0/css/all.min.css")
    link(rel="stylesheet", href="https://unpkg.com/filepond@^4/dist/filepond.css")
    link(rel="stylesheet", href="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.css")
    link(
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25/dist/sweetalert2.min.css"
    )
    link(rel="stylesheet", href="/admin/assets/css/style.css")
    link(rel="stylesheet", href="/admin/assets/css/card-admin.css")
    link(rel="stylesheet", href="/admin/assets/css/form.css")
    script.
      const pathAdmin = "#{pathAdmin}";
  body

    - if (messages.success)
      div(class="alert alert-success" alert-time="3000")
        span #{messages.success}
    
    //- Header
    include ../partials/header.pug
    //- End Header

    //- Sider
    include ../partials/sider.pug
    //- End Sider

    //- Main
    main.main
      block main
    //- End Main

    include ../partials/card-pin-modal.pug
    div(card-agent-config hidden data-card-agent-url=cardAgentUrl)
    script.
      window.CARD_AGENT_URL = document.querySelector('[card-agent-config]').dataset.cardAgentUrl;
    script(src="/assets/js/card/card-shared.js")
    script(src="/assets/js/card/card-client.js")

    script(src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js")
    script(src="https://unpkg.com/filepond-plugin-image-preview/dist/filepond-plugin-image-preview.js") 
    script(src="https://unpkg.com/filepond-plugin-file-validate-type/dist/filepond-plugin-file-validate-type.js") 
    script(src="https://unpkg.com/filepond@^4/dist/filepond.js")
    script(src="https://cdn.jsdelivr.net/npm/chart.js") 
    script(src="https://cdn.jsdelivr.net/npm/sweetalert2@11.26.25/dist/sweetalert2.all.min.js")
    script(src="/assets/js/ui-notice.js")
    script(src="/assets/js/vnd-money.js")
    script(src="/admin/assets/js/admin-form.js")
    block editor
    script(src="/admin/assets/js/script.js")
