    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    title #{pageTitle}
    link(rel="stylesheet", href="/admin/assets/css/style.css")
    script.
      const pathAdmin = "#{pathAdmin}";
  body
    .page-account
      block main

    include ../partials/card-pin-modal.pug
    div(card-agent-config hidden data-card-agent-url=cardAgentUrl)
