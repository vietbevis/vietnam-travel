// Footer
footer#lien-he.footer
  .container
    .inner-top
      h2.inner-title Đăng ký ngay để không bỏ lỡ các chương trình của chúng tôi
      form#email-form.inner-form(method="post" action="#")
        input#email-input(
          name="email" 
          aria-label="Email nhận thông tin"
          placeholder="Nhập email của bạn..." 
          type="email"
          required
          )
        button(type="submit") Đăng Ký Ngay
    .inner-middle
      nav.inner-links
        ul
          li
            a(href="/") Trang chủ
          li
            a(href="/search") Tìm tour
          if settingWebsiteInfo.phone
            li
              a(href=`tel:${settingWebsiteInfo.phone}`)= settingWebsiteInfo.phone
          if settingWebsiteInfo.email
            li
              a(href=`mailto:${settingWebsiteInfo.email}`)= settingWebsiteInfo.email
          if settingWebsiteInfo.address
            li= settingWebsiteInfo.address
    .inner-bottom
      .inner-copyright © 2024 28Tech. All rights reserved.
      .inner-logo
        a(href="/")
          if settingWebsiteInfo.logo
            img(alt=settingWebsiteInfo.websiteName || "Trang chủ" src=settingWebsiteInfo.logo)
          else
            span= settingWebsiteInfo.websiteName || "Trang chủ"
// End Footer
