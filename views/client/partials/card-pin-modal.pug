dialog.card-pin-dialog(card-pin-modal aria-labelledby="card-pin-title" aria-describedby="card-pin-status")
  form.card-pin-form(autocomplete="off" novalidate)
    .card-focus-icon
      i.fa-solid.fa-key(aria-hidden="true")
    h2#card-pin-title.card-pin-title(card-pin-title) Nhập mã PIN
    .card-field
      label(for="card-pin-input") Mã PIN (6 chữ số)
      input#card-pin-input.card-pin-input(card-pin-input type="password" inputmode="numeric" maxlength="6" minlength="6" pattern="[0-9]{6}" autocomplete="off" required)
    p#card-pin-status.card-pin-status(card-pin-status role="status" aria-live="polite")
    .card-pin-actions
      button.card-btn.card-btn-outline(card-pin-cancel type="button") Huỷ
      button.card-btn(type="submit") Xác nhận
