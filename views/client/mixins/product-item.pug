mixin product-item(item)
  - const hasPrice = Number.isSafeInteger(item.priceNewAdult) && item.priceNewAdult >= 0
  - const hasOriginalPrice = Number.isSafeInteger(item.priceAdult) && item.priceAdult > 0
  - const discount = hasPrice && hasOriginalPrice ? Math.floor((item.priceAdult - item.priceNewAdult) / item.priceAdult * 100) : 0

  .product-item
    .inner-image
      a(href=`/tour/detail/${item.slug}`)
        img(
          alt=item.name
          src=item.avatar
          )
    if discount > 0
      .inner-discount
        i.fa-solid.fa-bolt(aria-hidden="true")
        | Giảm -#{discount}%
    .inner-content
      h3.inner-title
        a(href=`/tour/detail/${item.slug}`) #{item.name}
      .inner-prices
        if discount > 0
          .inner-price-old
            | #{item.priceAdult.toLocaleString("vi-VN")}
            span.inner-unit đ
        .inner-price-new
          if hasPrice
            | #{item.priceNewAdult.toLocaleString("vi-VN")}
            span.inner-unit đ
          else
            | Giá chưa xác định
      .inner-desc
        //- .inner-desc-item
        //-   | Mã Tour:
        //-   b #{item.code}
        .inner-desc-item
          | Ngày Khởi Hành:
          b #{item.departureDateFormat}
        .inner-desc-item
          | Thời Gian:
          b #{item.time}
      .inner-meta
        //- .inner-rating
        //-   .inner-stars
        //-     - for(let i = 1; i <= item.ratingStars; i++)
        //-       i.fa-solid.fa-star
        //-     - for(let j = item.ratingStars + 1; j <= 5; j++)
        //-       i.fa-regular.fa-star
        //-   .inner-number (#{item.ratingTotal})
        .inner-stock
          .inner-label Người lớn còn:
          .inner-number #{item.stockAdult}
