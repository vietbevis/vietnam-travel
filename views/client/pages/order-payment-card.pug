extends ../layouts/default

block main
  - const money = value => Number(value).toLocaleString('vi-VN') + ' đ'
  main.card-account.card-narrow(data-card-pay data-order-id=orderDetail.id data-card-id=cardInfo.cardId data-phone=orderDetail.phone data-balance=cardInfo.balance data-total=orderDetail.total)
    .container
      .card-panel.card-focus
        .card-focus-icon
          i.fa-solid.fa-credit-card(aria-hidden="true")
        h1.card-page-title Thanh toán bằng ví thẻ
        dl.card-summary
          div.card-summary-row
            dt Mã đơn hàng
            dd #{orderDetail.orderCode}
          div.card-summary-row
            dt Tạm tính
            dd #{money(orderDetail.subTotal)}
          div.card-summary-row
            dt Giảm theo hạng thành viên
            dd.card-discount -#{money(orderDetail.discount || 0)}
          div.card-summary-row.card-summary-total
            dt Tổng thanh toán
            dd
              strong(data-pay-total)= money(orderDetail.total)
          div.card-summary-row.card-summary-balance
            dt Số dư ví hiện tại
            dd
              strong(data-pay-balance)= money(cardInfo.balance)
        if cardInfo.balance < orderDetail.total
          p.card-alert.card-alert-warning.card-warning Số dư ví không đủ. Vui lòng nạp thêm trước khi thanh toán.
        p.card-hint Cắm thẻ vào đầu đọc, bấm Thanh toán và nhập PIN. Mỗi giao dịch đều cần PIN.
        button.card-btn.card-btn-block(type="button" data-card-pay-button disabled=cardInfo.balance < orderDetail.total) Thanh toán
        p.card-alert.card-alert-info(data-customer-status role="status" aria-live="polite")
