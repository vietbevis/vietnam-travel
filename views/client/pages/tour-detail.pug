extends ../layouts/default.pug
include ../mixins/box-breadcrumb.pug

block main
  - const defaultAdult = tourDetail.stockAdult > 0 ? 1 : 0
  - const validPrice = value => Number.isSafeInteger(value) && value >= 0
  - const canBook = [tourDetail.priceNewAdult, tourDetail.priceNewChildren, tourDetail.priceNewBaby].every(validPrice)
  - const showPrice = value => validPrice(value) ? value.toLocaleString("vi-VN") : "Chưa xác định"
  // Breadcrumb
  +box-breadcrumb(breadcrumb)
  // End Breadcrumb

  // Section 10
  .section-10
    .container
      .inner-wrap
        .inner-left
          .box-images
            .inner-images-main
              .swiper.swiper-box-images-main
                .swiper-wrapper
                  each image in tourDetail.images
                    .swiper-slide
                      .inner-image
                        img(
                          alt="" 
                          src=image
                          )
            .inner-images-thumb
              .swiper.swiper-box-images-thumb
                .swiper-wrapper
                  each image in tourDetail.images
                    .swiper-slide
                      .inner-image
                        img(
                          alt="" 
                          src=image
                          )
          .box-tour-info
            .inner-title Thông Tin Tour
            .inner-content !{tourDetail.information}
            .inner-read-more
              button.button-outline Xem tất cả
          .box-tour-schedule
            .inner-title-main Lịch Trình Tour
            .inner-list
              each item in tourDetail.schedules
                .inner-item
                  .inner-title #{item.title}
                  .inner-content !{item.description}
        .inner-right
          .box-tour-detail
            .inner-title-main Chuyến Đi Của Bạn
            .inner-product
              .inner-image
                img(
                  alt="" 
                  src=tourDetail.avatar
                  )
              .inner-info
                .inner-title #{tourDetail.name}
                .inner-rating
                  .inner-stars
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                    i.fa-solid.fa-star
                  .inner-number 500 lượt đánh giá
            .inner-meta
              //- .inner-item
              //-   i.fa-solid.fa-ticket-simple
              //-   span Mã Tour:
              //-   span.inner-highlight 28T00001
              .inner-item
                i.fa-solid.fa-calendar-days
                span Thời Gian:
                span.inner-highlight #{tourDetail.time}
              .inner-item
                i.fa-solid.fa-truck-plane
                span Phương Tiện:
                span.inner-highlight #{tourDetail.vehicle}
              .inner-item
                i.fa-solid.fa-calendar-days
                span Ngày Khởi Hành:
                span.inner-highlight #{tourDetail.departureDateFormat}
            .inner-form
              label.inner-label Khởi Hành Tại:
              select(location-from)
                each item in cityList
                  option(value=item.id) #{item.name}
            .inner-stock-info
              div Người lớn còn: #{tourDetail.stockAdult} chỗ
              div Trẻ em còn: #{tourDetail.stockChildren} chỗ
              div Em bé còn: #{tourDetail.stockBaby} chỗ
            .inner-quantity
              label.inner-label Số Lượng Hành Khách
              .inner-list
                .inner-item
                  .inner-item-label Người lớn:
                  .inner-item-input
                    input(
                      value=defaultAdult
                      min="0" 
                      max=tourDetail.stockAdult
                      type="number"
                      input-stock-adult
                      price=tourDetail.priceNewAdult
                      )
                  .inner-item-price
                    span(stock-adult) #{defaultAdult}
                    span x
                    span.inner-highlight= showPrice(tourDetail.priceNewAdult)
                .inner-item
                  .inner-item-label Trẻ em:
                  .inner-item-input
                    input(
                      value="0" 
                      min="0" 
                      max=tourDetail.stockChildren
                      type="number"
                      input-stock-children
                      price=tourDetail.priceNewChildren
                      )
                  .inner-item-price
                    span(stock-children) 0
                    span x
                    span.inner-highlight= showPrice(tourDetail.priceNewChildren)
                .inner-item
                  .inner-item-label Em bé:
                  .inner-item-input
                    input(
                      value="0" 
                      min="0" 
                      max=tourDetail.stockBaby
                      type="number"
                      input-stock-baby
                      price=tourDetail.priceNewBaby
                      )
                  .inner-item-price
                    span(stock-baby) 0
                    span x
                    span.inner-highlight= showPrice(tourDetail.priceNewBaby)
            .inner-total
              .inner-total-label Tổng cộng:
              .inner-total-price
                span(total-price)= canBook ? showPrice(defaultAdult * tourDetail.priceNewAdult) : "Chưa xác định"
                if canBook
                  span đ
            if !canBook
              p(role="status") Chuyến đi chưa có đủ thông tin giá để đặt chỗ.
            button.inner-button-add-cart(type="button" tour-id=tourDetail.id disabled=!canBook) Thêm Vào Giỏ Hàng
  // End Section 10
