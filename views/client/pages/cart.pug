extends ../layouts/default.pug

block main
  // Section 11
  .section-11(page-cart data-discount-percent=customer ? tier.percent : 0)
    .container
      .inner-wrap
        .inner-head
          .inner-title Giỏ Hàng
          a.inner-back(href="/")
            | Quay lại mua hàng
            i.fa-solid.fa-angle-right
        .inner-tour-list(cart-list)
        .inner-list-price
          .inner-item
            .inner-label Tạm tình:
            .inner-price
              span(cart-sub-total) 0
              span đ
          .inner-item
            .inner-label Giảm:
            .inner-price
              span -
              span(cart-discount) 0
              span đ
              if customer && tier.percent > 0
                span.inner-tier.card-tier-note  (Hạng #{tier.label} giảm #{tier.percent}%)
          .inner-item
            .inner-label Thanh toán:
            .inner-price-highlight
              span(cart-total) 0
              span đ
  // End Section 11
  // Section 12
  .section-12
    .container
      .inner-wrap
        form#order-form(method="post" action="")
          .inner-info
            .inner-title-main Thông Tin Khách Hàng
            .inner-inputs
              .inner-input
                input#full-name-input(
                  placeholder="Họ và tên" 
                  name="fullName" 
                  type="text"
                  required
                  minlength="5"
                  maxlength="50"
                  autocomplete="name"
                  aria-label="Họ và tên"
                  value=customer ? customer.fullName : ""
                  )
              .inner-input
                input#phone-input(
                  placeholder="Số điện thoại" 
                  name="phone" 
                  type="tel"
                  required
                  autocomplete="tel"
                  aria-label="Số điện thoại"
                  value=customer ? customer.phone : ""
                  )
            button.card-btn.card-btn-outline.card-autofill(type="button" data-card-autofill data-card-id=card ? card.cardId : "")
              i.fa-solid.fa-id-card(aria-hidden="true")
              | Điền từ thẻ
            p.card-alert.card-alert-info(data-customer-status role="status" aria-live="polite")
            textarea(
              placeholder="Ghi chú" 
              name="note"
              )
          .inner-method
            .inner-title-main Chọn phương thức thanh toán
            .inner-list
              .inner-item
                input#methodMoney(
                  checked="" 
                  value="money" 
                  name="method" 
                  type="radio"
                  )
                label(for="methodMoney") Thanh toán tiền mặt khi đi tour
              .inner-item
                input#methodMomo(
                  value="momo" 
                  name="method" 
                  type="radio"
                  )
                label(for="methodMomo") Ví MoMo
              .inner-item
                input#methodZaloPay(
                  value="zalopay" 
                  name="method" 
                  type="radio"
                  )
                label(for="methodZaloPay") ZaloPay
              .inner-item
                input#methodVNPay(
                  value="vnpay" 
                  name="method" 
                  type="radio"
                  )
                label(for="methodVNPay") VNPay
              .inner-item
                input#methodBank(
                  value="bank" 
                  name="method" 
                  type="radio"
                  )
                label(for="methodBank") Chuyển khoản ngân hàng
              if customer
                .inner-item
                  input#methodCard(
                    value="card" 
                    name="method" 
                    type="radio"
                    )
                  label(for="methodCard") #[i.fa-solid.fa-credit-card(aria-hidden="true")]  Ví thẻ thành viên
            .inner-info-bank
              .inner-title Chuyển khoản ngân hàng
              .inner-text Hãy liên hệ nhân viên để nhận thông tin thanh toán của đơn hàng.
          .inner-button
            button(type="submit") ĐẶT TOUR
          p(data-checkout-feedback role="status" aria-live="polite")
  // End Section 12