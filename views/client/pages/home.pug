extends ../layouts/default.pug
include ../mixins/product-item.pug

block main
  // Section 1
  .section-1
    .container
      .inner-wrap
        h1.inner-title(
          data-aos-duration="800" 
          data-aos="fade-up"
          )
          | Du lịch Châu Á - Khám phá Mỹ, Úc, Âu
          br
          | Đi nơi đâu bạn muốn
        p.inner-desc(
          data-aos-delay="150" 
          data-aos-duration="800" 
          data-aos="fade-up"
          )
          | Chọn điểm đến, số khách và ngày khởi hành để tìm tour còn chỗ.
        form.inner-form(
          data-aos-delay="300" 
          data-aos-duration="800" 
          data-aos="fade-up" 
          action="#"
          form-search
          )
          .inner-box.inner-address
            .inner-input-group
              img.inner-icon(src="/assets/images/icon-address.svg")
              input.inner-input(
                placeholder="Bạn muốn đi đâu?" 
                type="text"
                name="locationTo"
                )
              i.fa-solid.fa-angle-down.inner-down
            if tourListSection2.length
              .inner-suggest
                .inner-suggest-title Tour gợi ý
                .inner-suggest-list
                  each tour in tourListSection2
                    .inner-item
                      .inner-item-content
                        .inner-item-title= tour.name
          .inner-box.inner-user
            .inner-input-group
              img.inner-icon(src="/assets/images/icon-user.svg")
              input.inner-input(
                placeholder="Số lượng" 
                type="text"
                readonly
                )
              i.fa-solid.fa-angle-down.inner-down
            .inner-quantity
              .inner-item
                .inner-label Người lớn
                .inner-count
                  button.inner-down(type="button" aria-label="Giảm số khách" class="guest-adjust") -
                  span.inner-number(stock-adult) 1
                  button.inner-up(type="button" aria-label="Tăng số khách" class="guest-adjust") +
              .inner-item
                .inner-label Trẻ em
                .inner-count
                  button.inner-down(type="button" aria-label="Giảm số khách" class="guest-adjust") -
                  span.inner-number(stock-children) 0
                  button.inner-up(type="button" aria-label="Tăng số khách" class="guest-adjust") +
              .inner-item
                .inner-label Em bé
                .inner-count
                  button.inner-down(type="button" aria-label="Giảm số khách" class="guest-adjust") -
                  span.inner-number(stock-baby) 0
                  button.inner-up(type="button" aria-label="Tăng số khách" class="guest-adjust") +
          .inner-box.inner-calendar
            .inner-input-group
              img.inner-icon(src="/assets/images/icon-calendar.svg")
              input.inner-input(type="date" name="departureDate")
          button.inner-button(type="submit")
            i.fa-solid.fa-magnifying-glass
            | Tìm Kiếm
  // End Section 1

  // Section 2
  .section-2(
    data-aos-delay="450" 
    data-aos-duration="800" 
    data-aos="fade-up"
    )
    .container
      .inner-wrap
        .inner-info
          h2.inner-title
            | Tour đang mở bán
          a.button-outline(href="/search") Tìm thêm tour
        .inner-list
          .swiper.swiper-section-2
            .swiper-wrapper
              each item in tourListSection2
                .swiper-slide
                  // Product Item
                  +product-item(item)
              else
                p.travel-empty Chưa có tour đang mở bán.
            .swiper-pagination
  // End Section 2

  // Section 3
  .section-3
    .container
      h2.box-title(
        data-aos-duration="800" 
        data-aos="fade-up"
        ) Khuyến Mại Bùng Nổ - Đánh Tan Nóng Bức
      .swiper.swiper-section-3(
        data-aos-delay="150" 
        data-aos-duration="800" 
        data-aos="fade-up"
        )
        .swiper-wrapper
          .swiper-slide
            .inner-item
              a(href="#")
                img(
                  alt="" 
                  src="/assets/images/banner-1.png"
                  )
          .swiper-slide
            .inner-item
              a(href="#")
                img(
                  alt="" 
                  src="/assets/images/banner-2.png"
                  )
          .swiper-slide
            .inner-item
              a(href="#")
                img(
                  alt="" 
                  src="/assets/images/banner-3.png"
                  )
        .swiper-pagination
  // End Section 3

  // Section 4
  .section-4
    .container
      h2.box-title(
        data-aos-duration="800" 
        data-aos="fade-up"
        ) Tour Trong Nước
      .inner-wrap(
        data-aos-delay="150" 
        data-aos-duration="800" 
        data-aos="fade-up"
        )
        each item in tourListSection4
          // Product Item
          +product-item(item)
          // End Product Item
        else
          p.travel-empty Chưa có tour trong nước đang mở bán.
      .inner-button
        a.button-outline(href=domesticToursHref) Xem tất cả
  // End Section 4

  // Section 5
  .section-5(
    data-aos-duration="800" 
    data-aos="fade-up"
    )
    .container
      .inner-image
        a(href="#")
          img(
            alt="" 
            src="/assets/images/banner-4.png"
            )
  // End Section 5

  .section-4
    .container
      h2.box-title Tour nước ngoài
      .inner-button
        a.button-outline(href=foreignToursHref) Tìm tour nước ngoài

  // Section 7
  .section-5(
    data-aos-duration="800" 
    data-aos="fade-up"
    )
    .container
      .inner-image
        a(href="#")
          img(
            alt="" 
            src="/assets/images/banner-5.png"
            )
  // End Section 7
